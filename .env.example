# Chat con PDFs (RagWorkbench → /api/rag)
GEMINI_API_KEY=
# Opcional: modelo para respuestas multimodales con PDF (por defecto gemini-2.5-flash)
# GEMINI_CHAT_MODEL=gemini-2.5-flash
# Embeddings opcionales para búsqueda semántica (pgvector, 768 dims).
# La búsqueda FTS + pg_trgm funciona sin esto; si falla el modelo, el guardado en admin sigue activo.
# GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Google (Vision / Gemini) — scripts de extracción alternativos
# GOOGLE_APPLICATION_CREDENTIALS=
# GCS_BUCKET=

# Neon PostgreSQL — fuente de verdad (requerido)
# DATABASE_URL=postgresql://...

# Búsqueda híbrida en Neon: FTS (spanish) + pg_trgm + pgvector
SEARCH_HYBRID_ENABLED=true
# Peso semántico 0–0.85 (resto va a full-text)
SEARCH_SEMANTIC_WEIGHT=0.4
# Distancia coseno máxima pgvector (<=>); menor = más estricto
SEARCH_VECTOR_MAX_DISTANCE=0.55

# Panel admin (/admin) — consume y edita datos ya cargados en Neon (sin migraciones desde la app)
# Carga masiva sigue por CLI: npm run etl:faq:xlsx
ADMIN_ENABLED=false
NEXT_PUBLIC_ADMIN_ENABLED=false

# Reindexar documento + embeddings desde admin (false por defecto)
SEARCH_REINDEX_ENABLED=false

# Amazon Textract + S3 — npm run extract:doop-textract
AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
UTPL_TEXTRACT_S3_BUCKET=
